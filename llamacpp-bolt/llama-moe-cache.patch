+void llama_moe_cache_get_stats(struct llama_context * ctx, size_t * hits, size_t * misses, size_t * bytes_uploaded, size_t * prefetch_hits) {
+    if (!ctx || !ctx->get_moe_cache()) {
+        if (hits) *hits = 0;
+        if (misses) *misses = 0;
+        if (bytes_uploaded) *bytes_uploaded = 0;
+        if (prefetch_hits) *prefetch_hits = 0;
+        return;
+    }
+    auto st = ctx->get_moe_cache()->get_stats();
+    if (hits) *hits = st.hits_small + st.hits_large;
+    if (misses) *misses = st.misses_small + st.misses_large;
+    if (bytes_uploaded) *bytes_uploaded = st.bytes_small + st.bytes_large;
+    if (prefetch_hits) *prefetch_hits = st.prefetch_hits;
+}
+
+void llama_moe_cache_get_ext_stats(struct llama_context * ctx, struct llama_moe_cache::cache_stats * out_stats) {
+    if (!out_stats) {
+        return;
+    }
+    if (!ctx || !ctx->get_moe_cache()) {
+        *out_stats = {};
+        return;
+    }
+    *out_stats = ctx->get_moe_cache()->get_stats();
+}
+
+void llama_moe_cache_reset_stats(struct llama_context * ctx) {
+    if (ctx && ctx->get_moe_cache()) {
+        ctx->get_moe_cache()->reset_stats();
+    }
+}
